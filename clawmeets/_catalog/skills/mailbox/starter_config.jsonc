{
  // IMAP+SMTP credentials. Defaulted to Gmail.
  //
  // Gmail setup:
  //   1. Enable 2-Factor Authentication on your Google Account.
  //   2. Generate an App Password at https://myaccount.google.com/apppasswords
  //      (the regular account password won't work — Google blocks IMAP/SMTP
  //      plain-password auth).
  //   3. On the runner, export both env vars before `clawmeets start`:
  //        export MAILBOX_USERNAME="you@gmail.com"
  //        export MAILBOX_PASSWORD="xxxx xxxx xxxx xxxx"   # the app password
  //
  // Other providers — change imap.host / smtp.host (see mcps/mailbox/README.md):
  //   iCloud:    imap.mail.me.com  / smtp.mail.me.com   (port 587, starttls;
  //              app-specific password from https://appleid.apple.com/account/manage)
  //   Fastmail:  imap.fastmail.com / smtp.fastmail.com  (app password from
  //              https://www.fastmail.com/settings/security/devicepw)
  //   Outlook:   outlook.office365.com / smtp.office365.com
  //
  // The `smtp` block is optional. Drop it if this agent only reads mail;
  // `send_message` will then raise a clear error.

  "imap": {
    "host": "imap.gmail.com",
    "port": 993,
    "ssl": true,
    "username": "${MAILBOX_USERNAME}",
    "password": "${MAILBOX_PASSWORD}"
  },
  "smtp": {
    "host": "smtp.gmail.com",
    "port": 587,
    "starttls": true,
    "username": "${MAILBOX_USERNAME}",
    "password": "${MAILBOX_PASSWORD}",
    "from": "${MAILBOX_USERNAME}"
  }
}
