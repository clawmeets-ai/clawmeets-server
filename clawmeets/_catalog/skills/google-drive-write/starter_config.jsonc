{
  // google-drive-write — read AND write N configured Google Sheet targets.
  //
  // Each entry in `sheet_targets` is one tab on one spreadsheet the agent can
  // operate on. Tools (`read_sheet_rows`, `append_sheet_rows`,
  // `update_sheet_cell`) take a `target_name` selecting which entry to use.
  //
  // The OAuth scope is `spreadsheets` (write); install this MCP separately
  // from the read-only `google-drive` MCP so you can opt into each
  // independently.
  //
  // Per-entry fields:
  //   name            — logical key the LLM passes as `target_name`. Must be
  //                     unique within `sheet_targets`.
  //   spreadsheet_id  — the long id in the Sheet URL between /d/ and /edit.
  //                     Inline the literal id OR use a ${VAR} placeholder
  //                     resolved from runner env (e.g. ${MARKETING_SHEET_ID}).
  //   sheet_name      — the tab name (NOT the file name). Defaults to
  //                     "Sheet1" in a brand-new Sheet.
  //   row_id_column   — header name of the primary-key column used by
  //                     update_sheet_cell to find rows. Optional; defaults to
  //                     "id". The marketing pipeline expects "id".
  //
  // Each target's sheet MUST have a header row in row 1; tools key cell
  // values on it. For the marketing pipeline, paste this header into row 1
  // of the `ideas` tab:
  //   id  created_at  channel  idea_title  idea_brief  grade  grade_rationale
  //   sign_off  draft_body  drafted_at  publish_sign_off  notes

  "sheet_targets": [
    {
      "name": "ideas",
      "spreadsheet_id": "${MARKETING_SHEET_ID}",
      "sheet_name": "ideas",
      "row_id_column": "id"
    }
    // Add more entries here to operate on additional tabs / sheets, e.g.:
    // {
    //   "name": "ops",
    //   "spreadsheet_id": "${OPS_SHEET_ID}",
    //   "sheet_name": "tasks",
    //   "row_id_column": "id"
    // }
  ]
}
